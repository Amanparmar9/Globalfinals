# =============================================================================
# AI Hackathon Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="AI Hackathon Platform"
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=DATABASE_URL=postgresql+asyncpg://postgres:Hello%40123456@localhost:5432/postgres

# ─── JWT Security ────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE_ME_generate_a_strong_64_byte_hex_secret_key_here
ALGORITHM=HS256

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Password Policy ──────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
PASSWORD_HISTORY_LIMIT=5
PASSWORD_EXPIRY_DAYS=90
PASSWORD_WARNING_DAYS=30

# ─── Rate Limiting & Lockout ─────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Initial Super Admin (created on first startup) ──────────────────────────
SUPER_ADMIN_EMAIL=admin@aifriday.com
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Admin@2024SecureKey#99

# ─── MFA (scaffold — TOTP keys stored encrypted) ────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_generate_a_fernet_key_here
